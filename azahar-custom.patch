diff -ruN a/src/android/app/src/main/java/org/citra/citra_emu/features/settings/utils/PerGameSettings.kt b/src/android/app/src/main/java/org/citra/citra_emu/features/settings/utils/PerGameSettings.kt
--- a/src/android/app/src/main/java/org/citra/citra_emu/features/settings/utils/PerGameSettings.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/src/android/app/src/main/java/org/citra/citra_emu/features/settings/utils/PerGameSettings.kt	2026-10-12 03:36:21.828795587 +0000
@@ -0,0 +1,188 @@
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+package org.citra.citra_emu.features.settings.utils
+
+import androidx.documentfile.provider.DocumentFile
+import android.net.Uri
+import org.citra.citra_emu.CitraApplication
+import org.citra.citra_emu.utils.DirectoryInitialization.userDirectory
+import org.citra.citra_emu.utils.FileUtil
+import org.citra.citra_emu.utils.Log
+import org.ini4j.Wini
+
+/**
+ * Per-game overrides, stored as <user dir>/config/custom/<TITLEID>.ini. The native side layers
+ * this file over config.ini when the game boots (see Config::SourceFor in jni/config.cpp), so any
+ * key present here wins and everything else falls back to the global settings.
+ *
+ * A null field in [Options] means "not overridden by this game". Writing then removes the key so
+ * the game keeps inheriting the global value, which is why opening the Koji menu and pressing Save
+ * can never pin a value the user did not actually change.
+ */
+object PerGameSettings {
+    /** Keys owned by the "Performance boost" preset; all are removed again when it is turned off. */
+    private val BOOST_KEYS = listOf(
+        "Renderer" to "use_vsync",
+        "Renderer" to "async_shader_compilation",
+        "Renderer" to "async_presentation",
+        "Renderer" to "use_hw_shader",
+        "Renderer" to "use_disk_shader_cache",
+        "Renderer" to "use_skip_duplicate_frames",
+        "Core" to "use_cpu_jit"
+    )
+
+    /** The Koji menu options for a single game. */
+    data class Options(
+        var patch60fps: Boolean? = null,
+        var boost: Boolean = false,
+        var resolutionFactor: Int? = null,
+        var textureFilter: Int? = null,
+        var linearFilter: Boolean? = null,
+        var textureSampling: Int? = null,
+        var cpuClockPercent: Int? = null,
+        var speedLimitPercent: Int? = null
+    ) {
+        companion object {
+            const val DEFAULT_RESOLUTION = 1
+            const val DEFAULT_TEXTURE_FILTER = 0
+            const val DEFAULT_LINEAR_FILTER = true
+            const val DEFAULT_TEXTURE_SAMPLING = 0
+            const val DEFAULT_CPU_CLOCK = 100
+            const val DEFAULT_SPEED_LIMIT = 100
+        }
+    }
+
+    private const val DIR = "custom"
+
+    fun fileName(titleId: Long) = String.format("%016X.ini", titleId)
+
+    private fun configDir(): DocumentFile? {
+        val root = DocumentFile.fromTreeUri(CitraApplication.appContext, Uri.parse(userDirectory))
+        return root?.findFile("config")
+    }
+
+    private fun customFile(titleId: Long): DocumentFile? =
+        configDir()?.findFile(DIR)?.findFile(fileName(titleId))
+
+    private fun put(ini: Wini, section: String, key: String, value: Any?) {
+        if (value == null) {
+            ini.remove(section, key)
+        } else {
+            ini.put(section, key, value.toString())
+        }
+    }
+
+    private fun asInt(value: String?): Int? = value?.trim()?.toIntOrNull()
+
+    fun load(titleId: Long): Options {
+        val options = Options()
+        try {
+            val file = customFile(titleId)
+            if (file == null || file.length() <= 0L) {
+                return options
+            }
+            val stream = CitraApplication.appContext.contentResolver.openInputStream(file.uri)
+                ?: return options
+            stream.use {
+                val ini = Wini(it)
+                val vsync = ini.get("Renderer", "use_vsync")
+                val asyncShaders = ini.get("Renderer", "async_shader_compilation")
+                options.boost = vsync == "0" && asyncShaders == "1"
+                options.patch60fps = ini.get("Renderer", "use_60fps_patch")?.let { it == "1" }
+                options.resolutionFactor = asInt(ini.get("Renderer", "resolution_factor"))
+                options.textureFilter = asInt(ini.get("Renderer", "texture_filter"))
+                options.linearFilter = ini.get("Renderer", "filter_mode")?.let { it != "0" }
+                options.textureSampling = asInt(ini.get("Renderer", "texture_sampling"))
+                options.cpuClockPercent = asInt(ini.get("Core", "cpu_clock_percentage"))
+                options.speedLimitPercent = if (ini.get("Renderer", "use_frame_limit") == "0") {
+                    0
+                } else {
+                    asInt(ini.get("Renderer", "frame_limit"))
+                }
+            }
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] load failed: ${e.message}")
+        }
+        return options
+    }
+
+    /** Applies [options] to this game's override file, preserving every other key in it. */
+    fun save(titleId: Long, options: Options): Boolean {
+        try {
+            val cfg = configDir() ?: return false
+            val dir = cfg.findFile(DIR) ?: cfg.createDirectory(DIR) ?: return false
+            var file = dir.findFile(fileName(titleId))
+            if (file == null) {
+                file = FileUtil.createFile(dir.uri.toString(), fileName(titleId)) ?: return false
+            }
+
+            val ini = if (file.length() > 0L) {
+                val input = CitraApplication.appContext.contentResolver.openInputStream(file.uri)
+                    ?: return false
+                input.use { Wini(it) }
+            } else {
+                Wini()
+            }
+
+            put(ini, "Renderer", "use_60fps_patch",
+                options.patch60fps?.let { if (it) 1 else 0 })
+            put(ini, "Renderer", "resolution_factor", options.resolutionFactor)
+            put(ini, "Renderer", "texture_filter", options.textureFilter)
+            put(ini, "Renderer", "filter_mode",
+                options.linearFilter?.let { if (it) 1 else 0 })
+            put(ini, "Renderer", "texture_sampling", options.textureSampling)
+            put(ini, "Core", "cpu_clock_percentage", options.cpuClockPercent)
+            put(ini, "Renderer", "use_frame_limit",
+                options.speedLimitPercent?.let { if (it == 0) 0 else 1 })
+            put(ini, "Renderer", "frame_limit", options.speedLimitPercent?.let { if (it == 0) 100 else it })
+
+            if (options.boost) {
+                ini.put("Renderer", "use_vsync", 0)
+                ini.put("Renderer", "async_shader_compilation", 1)
+                ini.put("Renderer", "async_presentation", 1)
+                ini.put("Renderer", "use_hw_shader", 1)
+                ini.put("Renderer", "use_disk_shader_cache", 1)
+                ini.put("Renderer", "use_skip_duplicate_frames", 1)
+                ini.put("Core", "use_cpu_jit", 1)
+            } else {
+                BOOST_KEYS.forEach { (section, key) -> ini.remove(section, key) }
+            }
+
+            val out = CitraApplication.appContext.contentResolver.openOutputStream(file.uri, "wt")
+                ?: return false
+            out.use { ini.store(it) }
+            return true
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] save failed: ${e.message}")
+            return false
+        }
+    }
+
+    /** Toggles only the 60 FPS patch flag, leaving the rest of the game's overrides intact. */
+    fun save60fps(titleId: Long, enabled: Boolean): Boolean {
+        try {
+            val cfg = configDir() ?: return false
+            val dir = cfg.findFile(DIR) ?: cfg.createDirectory(DIR) ?: return false
+            var file = dir.findFile(fileName(titleId))
+            if (file == null) {
+                file = FileUtil.createFile(dir.uri.toString(), fileName(titleId)) ?: return false
+            }
+            val ini = if (file.length() > 0L) {
+                val input = CitraApplication.appContext.contentResolver.openInputStream(file.uri)
+                    ?: return false
+                input.use { Wini(it) }
+            } else {
+                Wini()
+            }
+            ini.put("Renderer", "use_60fps_patch", if (enabled) 1 else 0)
+            val out = CitraApplication.appContext.contentResolver.openOutputStream(file.uri, "wt")
+                ?: return false
+            out.use { ini.store(it) }
+            return true
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] save60fps failed: ${e.message}")
+            return false
+        }
+    }
+}
