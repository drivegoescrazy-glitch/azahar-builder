 /**
+ * Directories holding user patches for a title, most specific first. Both folders share the same
+ * layout (exefs/code.ips, romfs/, exheader.bin ...). The per-game "60 FPS patch" option prepends
+ * load/60fps/<TITLEID>/ so a 60 FPS patch layers on top of a game's other mods instead of
+ * replacing them; enabling it therefore never silently disables load/mods/<TITLEID>/.
+ */
+static std::vector<std::string> GetModsPaths(u64 program_id) {
+    const auto& load_dir = FileUtil::GetUserPath(FileUtil::UserPath::LoadDir);
+    const u64 id = GetModId(program_id);
+    std::vector<std::string> paths;
+    if (Settings::values.use_60fps_patch.GetValue()) {
+        auto fps_path = fmt::format("{}60fps/{:016X}/", load_dir, id);
+        if (FileUtil::Exists(fps_path)) {
+            LOG_INFO(Service_FS, "Layering 60 FPS patch folder {}", fps_path);
+            paths.push_back(std::move(fps_path));
+        } else {
+            LOG_WARNING(Service_FS, "60 FPS patch enabled but load/60fps/{:016X}/ does not exist",
+                        id);
+        }
+    }
+    paths.push_back(fmt::format("{}mods/{:016X}/", load_dir, id));
+    return paths;
+}
