+/**
+ * Per-game overrides, stored as <user dir>/config/custom/<TITLEID>.ini. The native side layers
+ * this file over config.ini when the game boots (see Config::SourceFor in jni/config.cpp), so any
+ * key present here wins and everything else falls back to the global settings.
+ *
+ * Only fields named in the changed-control set are saved. Untouched overrides, including values
+ * outside the quick menu range, stay intact. The preset records which values it owns and backs up
+ * their previous overrides before changing them.
+ */
+object PerGameSettings {
+    /** Keys owned by the performance preset; previous overrides are restored when it is disabled. */
+    private val BOOST_KEYS = listOf(
+        "Renderer" to "use_vsync",
+        "Renderer" to "async_shader_compilation",
+        "Renderer" to "async_presentation",
+        "Renderer" to "use_hw_shader",
+        "Renderer" to "use_disk_shader_cache",
+        "Renderer" to "use_skip_duplicate_frames",
+        "Core" to "use_cpu_jit",
+        "Utility" to "dump_textures",
+        "Utility" to "async_custom_loading"
+    )
+
+    /** The Koji menu options for a single game. */
+    data class Options(
+        var patch60fps: Boolean? = null,
+        var boost: Boolean = false,
+        var resolutionFactor: Int? = null,
+        var textureFilter: Int? = null,
+        var linearFilter: Boolean? = null,
+        var textureSampling: Int? = null,
+        var cpuClockPercent: Int? = null,
+        var speedLimitPercent: Int? = null,
+        var integerScaling: Boolean? = null,
+        var customTextures: Boolean? = null,
+        var preloadTextures: Boolean? = null,
+        var asyncTextures: Boolean? = null
+    ) {
+        companion object {
+            const val DEFAULT_RESOLUTION = 1
+            const val DEFAULT_TEXTURE_FILTER = 0
+            const val DEFAULT_LINEAR_FILTER = true
+            const val DEFAULT_TEXTURE_SAMPLING = 0
+            const val DEFAULT_CPU_CLOCK = 100
+            const val DEFAULT_SPEED_LIMIT = 100
+        }
+    }
+
+    private const val DIR = "custom"
+
+    fun fileName(titleId: Long) = String.format("%016X.ini", titleId)
+
+    private fun configDir(): DocumentFile? {
+        val root = DocumentFile.fromTreeUri(CitraApplication.appContext, Uri.parse(userDirectory))
+        return root?.findFile("config")
+    }
+
+    private fun customFile(titleId: Long): DocumentFile? =
+        configDir()?.findFile(DIR)?.findFile(fileName(titleId))
+
+    /**
+     * Writes or clears a single key. ini4j's two-argument Map remove cannot be called from Kotlin
+     * (its value type parameter only appears in the return type), so removal goes through the
+     * section instead.
+     */
+    private fun put(ini: Wini, section: String, key: String, value: Any?) {
+        if (value == null) {
+            ini.get(section)?.remove(key)
+        } else {
+            ini.put(section, key, value.toString())
+        }
+    }
+
+    private fun asInt(value: String?): Int? = value?.trim()?.toIntOrNull()
+
+    private fun Wini.boolean(section: String, key: String): Boolean? =
+        get(section, key)?.trim()?.let { it == "1" || it.equals("true", ignoreCase = true) }
+
+    fun load(titleId: Long): Options {
+        val options = Options()
+        try {
+            val resolver = CitraApplication.appContext.contentResolver
+            val globalFile = configDir()?.findFile("config.ini")
+            val global = globalFile?.let { file ->
+                resolver.openInputStream(file.uri)?.use { Wini(it) }
+            } ?: Wini()
+            val file = customFile(titleId)
+            val ini = if (file != null && file.length() > 0L) {
+                resolver.openInputStream(file.uri)?.use { Wini(it) }
+                    ?: throw java.io.IOException("Unable to read per-game settings")
+            } else {
+                Wini()
+            }
+            // Display effective global+title values; only edited controls become overrides.
+            val effective = Wini()
+            for (source in listOf(global, ini)) {
+                for ((section, entries) in source) {
+                    for ((key, value) in entries) effective.put(section, key, value)
+                }
+            }
+            run {
+                options.boost = ini.boolean("Kojii", "boost") == true
+                options.patch60fps = ini.boolean("Renderer", "use_60fps_patch")
+                options.resolutionFactor = asInt(effective.get("Renderer", "resolution_factor"))
+                options.textureFilter = asInt(effective.get("Renderer", "texture_filter"))
+                options.linearFilter = effective.boolean("Renderer", "filter_mode")
+                options.integerScaling = effective.boolean("Renderer", "use_integer_scaling")
+                options.customTextures = effective.boolean("Utility", "custom_textures")
+                options.preloadTextures = effective.boolean("Utility", "preload_textures")
+                options.asyncTextures = effective.boolean("Utility", "async_custom_loading")
+                options.textureSampling = asInt(effective.get("Renderer", "texture_sampling"))
+                options.cpuClockPercent = asInt(effective.get("Core", "cpu_clock_percentage"))
+                options.speedLimitPercent = if (effective.boolean("Renderer", "use_frame_limit") == false) {
+                    0
+                } else {
+                    asInt(effective.get("Renderer", "frame_limit"))
+                }
+            }
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] load failed: ${e.message}")
+        }
+        return options
+    }
+
+    /** Merge only controls the user edited. Untouched and unsupported values survive verbatim. */
+    @Synchronized
+    fun save(titleId: Long, options: Options, changed: Set<String>): Boolean {
+        if (changed.isEmpty()) return true
+        try {
+            val cfg = configDir() ?: return false
+            val dir = cfg.findFile(DIR) ?: cfg.createDirectory(DIR) ?: return false
+            var file = dir.findFile(fileName(titleId))
+            if (file == null) {
+                file = FileUtil.createFile(dir.uri.toString(), fileName(titleId)) ?: return false
+            }
+
+            val ini = if (file.length() > 0L) {
+                val input = CitraApplication.appContext.contentResolver.openInputStream(file.uri)
+                    ?: return false
+                input.use { Wini(it) }
+            } else {
+                Wini()
+            }
+
+            if ("patch60fps" in changed) {
+                put(ini, "Renderer", "use_60fps_patch", options.patch60fps?.let { if (it) 1 else 0 })
+            }
+            if ("resolutionFactor" in changed) {
+                put(ini, "Renderer", "resolution_factor", options.resolutionFactor)
+            }
+            if ("textureFilter" in changed) {
+                put(ini, "Renderer", "texture_filter", options.textureFilter)
+            }
+            if ("linearFilter" in changed) {
+                put(ini, "Renderer", "filter_mode", options.linearFilter?.let { if (it) 1 else 0 })
+            }
+            if ("textureSampling" in changed) {
+                put(ini, "Renderer", "texture_sampling", options.textureSampling)
+            }
+            if ("cpuClockPercent" in changed) {
+                put(ini, "Core", "cpu_clock_percentage", options.cpuClockPercent)
+            }
+            if ("speedLimitPercent" in changed) {
+                put(ini, "Renderer", "use_frame_limit",
+                    options.speedLimitPercent?.let { if (it == 0) 0 else 1 })
+                put(ini, "Renderer", "frame_limit",
+                    options.speedLimitPercent?.let { if (it == 0) 100 else it })
+            }
+            for ((field, section, key) in listOf(
+                Triple("integerScaling", "Renderer", "use_integer_scaling"),
+                Triple("customTextures", "Utility", "custom_textures"),
+                Triple("preloadTextures", "Utility", "preload_textures"),
+                Triple("asyncTextures", "Utility", "async_custom_loading")
+            )) {
+                if (field !in changed) continue
+                val value = when (field) {
+                    "integerScaling" -> options.integerScaling
+                    "customTextures" -> options.customTextures
+                    "preloadTextures" -> options.preloadTextures
+                    else -> options.asyncTextures
+                }
+                put(ini, section, key, value?.let { if (it) 1 else 0 })
+            }
+            if ("patch60fps" in changed && options.patch60fps == true) {
+                if (!has60fpsCodePatch(titleId)) return false
+                ini.put("Renderer", "use_frame_limit", 1)
+                ini.put("Renderer", "frame_limit", 100)
+            }
+            if ("boost" in changed) {
+                val wasEnabled = ini.boolean("Kojii", "boost") == true
+                for ((section, key) in BOOST_KEYS) {
+                    val backupKey = "${section}_$key"
+                    if (options.boost) {
+                        if (!wasEnabled) {
+                            ini.put("Kojii Boost Backup", backupKey,
+                                ini.get(section, key) ?: "<inherit>")
+                        }
+                        ini.put(section, key, if (key in setOf("use_vsync", "dump_textures")) 0 else 1)
+                    } else if (wasEnabled) {
+                        // Restore only while the preset still owns this value. An advanced edit
+                        // made after enabling the preset must not be lost when it is disabled.
+                        val presetValue = key !in setOf("use_vsync", "dump_textures")
+                        if (ini.boolean(section, key) == presetValue) {
+                            val previous = ini.get("Kojii Boost Backup", backupKey)
+                            put(ini, section, key, previous?.takeUnless { it == "<inherit>" })
+                        }
+                        ini.get("Kojii Boost Backup")?.remove(backupKey)
+                    }
+                }
+                ini.put("Kojii", "boost", if (options.boost) 1 else 0)
+            }
+
+            val out = CitraApplication.appContext.contentResolver.openOutputStream(file.uri, "wt")
+                ?: return false
+            out.use { ini.store(it) }
+            return true
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] save failed: ${e.message}")
+            return false
+        }
+    }
+
+    /** Checks supported executable patch files, not an empty directory or a cheat text file. */
+    fun has60fpsCodePatch(titleId: Long): Boolean = try {
+        val root = DocumentFile.fromTreeUri(CitraApplication.appContext, Uri.parse(userDirectory))
+        val title = root?.findFile("load")?.findFile("60fps")
+            ?.findFile(fileName(titleId).removeSuffix(".ini"))
+        val resolver = CitraApplication.appContext.contentResolver
+        listOfNotNull(title?.findFile("exefs"), title).any { folder ->
+            listOf("code.ips", "code.bps").any { name ->
+                val patch = folder.findFile(name)
+                if (patch == null || patch.length() < 8L) false else {
+                    resolver.openInputStream(patch.uri)?.use { stream ->
+                        val header = ByteArray(5)
+                        var count = 0
+                        while (count < header.size) {
+                            val value = stream.read()
+                            if (value < 0) break
+                            header[count++] = value.toByte()
+                        }
+                        (name.endsWith("ips") && String(header, Charsets.US_ASCII) == "PATCH") ||
+                            (name.endsWith("bps") && String(header, 0, 4, Charsets.US_ASCII) == "BPS1")
+                    } ?: false
+                }
+            }
+        }
+    } catch (e: Exception) {
+        Log.error("[PerGameSettings] patch check failed: ${e.message}")
+        false
+    }
+
+    /** Explicitly inherit global settings; no other game's file is touched. */
+    @Synchronized
+    fun reset(titleId: Long): Boolean = try {
+        val file = customFile(titleId)
+        file == null || file.delete()
+    } catch (e: Exception) {
+        Log.error("[PerGameSettings] reset failed: ${e.message}")
+        false
+    }
+}
