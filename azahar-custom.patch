+++ b/src/android/app/src/main/java/org/citra/citra_emu/features/settings/ui/PerGameSettingsDialog.kt	2026-10-12 03:43:09.076994875 +0000
@@ -0,0 +1,162 @@
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+package org.citra.citra_emu.features.settings.ui
+
+import android.content.Context
+import android.view.LayoutInflater
+import android.widget.ArrayAdapter
+import android.widget.TextView
+import android.widget.Toast
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.google.android.material.materialswitch.MaterialSwitch
+import com.google.android.material.slider.Slider
+import com.google.android.material.textfield.MaterialAutoCompleteTextView
+import org.citra.citra_emu.R
+import org.citra.citra_emu.features.settings.utils.PerGameSettings
+import org.citra.citra_emu.model.Game
+
+/**
+ * The Koji menu: per-game performance and visual options, written to this title's own override
+ * file. Nothing here touches config.ini, and options left at their default keep inheriting the
+ * global settings instead of being pinned.
+ */
+object PerGameSettingsDialog {
+    private const val MIN_CPU_CLOCK = 25
+    private const val MAX_CPU_CLOCK = 200
+    private const val MIN_RESOLUTION = 1
+    private const val MAX_RESOLUTION = 4
+    private const val MAX_SPEED_LIMIT = 200
+
+    /**
+     * Returns the value to persist: a value the user actually changed becomes an override, while a
+     * value left at its default stays "inherit" unless the game already overrode it.
+     */
+    private fun <T> asOverride(initial: T?, fallback: T, chosen: T): T? =
+        if (chosen != fallback) chosen else initial
+
+    fun show(context: Context, game: Game) {
+        val view = LayoutInflater.from(context).inflate(R.layout.dialog_per_game_settings, null)
+        val initial = PerGameSettings.load(game.titleId)
+
+        val boost = view.findViewById<MaterialSwitch>(R.id.pg_boost)
+        val patch = view.findViewById<MaterialSwitch>(R.id.pg_60fps)
+        val cpuClock = view.findViewById<Slider>(R.id.pg_cpu_clock)
+        val cpuClockLabel = view.findViewById<TextView>(R.id.pg_cpu_clock_label)
+        val speedLimit = view.findViewById<Slider>(R.id.pg_speed_limit)
+        val speedLimitLabel = view.findViewById<TextView>(R.id.pg_speed_limit_label)
+        val resolution = view.findViewById<Slider>(R.id.pg_resolution)
+        val resolutionLabel = view.findViewById<TextView>(R.id.pg_resolution_label)
+        val textureFilter = view.findViewById<MaterialAutoCompleteTextView>(R.id.pg_texture_filter)
+        val linearFilter = view.findViewById<MaterialSwitch>(R.id.pg_linear_filter)
+        val sampling = view.findViewById<MaterialAutoCompleteTextView>(R.id.pg_sampling)
+
+        boost.isChecked = initial.boost
+        patch.isChecked = initial.patch60fps ?: false
+
+        val cpuClockValue = (initial.cpuClockPercent
+            ?: PerGameSettings.Options.DEFAULT_CPU_CLOCK)
+            .coerceIn(MIN_CPU_CLOCK, MAX_CPU_CLOCK)
+        cpuClock.value = cpuClockValue.toFloat()
+        cpuClockLabel.text = context.getString(R.string.pg_cpu_label, cpuClockValue)
+        cpuClock.addOnChangeListener { _, value, _ ->
+            cpuClockLabel.text = context.getString(R.string.pg_cpu_label, value.toInt())
+        }
+
+        val speedLimitValue = (initial.speedLimitPercent
+            ?: PerGameSettings.Options.DEFAULT_SPEED_LIMIT)
+            .coerceIn(0, MAX_SPEED_LIMIT)
+        speedLimit.value = speedLimitValue.toFloat()
+        speedLimitLabel.text = speedLimitText(context, speedLimitValue)
+        speedLimit.addOnChangeListener { _, value, _ ->
+            speedLimitLabel.text = speedLimitText(context, value.toInt())
+        }
+
+        val resolutionValue = (initial.resolutionFactor
+            ?: PerGameSettings.Options.DEFAULT_RESOLUTION)
+            .coerceIn(MIN_RESOLUTION, MAX_RESOLUTION)
+        resolution.value = resolutionValue.toFloat()
+        resolutionLabel.text = context.getString(R.string.pg_res_label, resolutionValue)
+        resolution.addOnChangeListener { _, value, _ ->
+            resolutionLabel.text = context.getString(R.string.pg_res_label, value.toInt())
+        }
+
+        val filterNames = context.resources.getStringArray(R.array.pg_texture_filter_names)
+        textureFilter.setAdapter(
+            ArrayAdapter(context, R.layout.support_simple_spinner_dropdown_item, filterNames)
+        )
+        val filterIndex = (initial.textureFilter
+            ?: PerGameSettings.Options.DEFAULT_TEXTURE_FILTER).coerceIn(0, filterNames.size - 1)
+        textureFilter.setText(filterNames[filterIndex], false)
+
+        linearFilter.isChecked = initial.linearFilter
+            ?: PerGameSettings.Options.DEFAULT_LINEAR_FILTER
+
+        val samplingNames = context.resources.getStringArray(R.array.pg_sampling_names)
+        sampling.setAdapter(
+            ArrayAdapter(context, R.layout.support_simple_spinner_dropdown_item, samplingNames)
+        )
+        val samplingIndex = (initial.textureSampling
+            ?: PerGameSettings.Options.DEFAULT_TEXTURE_SAMPLING).coerceIn(0, samplingNames.size - 1)
+        sampling.setText(samplingNames[samplingIndex], false)
+
+        MaterialAlertDialogBuilder(context)
+            .setTitle(
+                context.getString(R.string.koji_menu_title) + ": " + game.title
+            )
+            .setView(view)
+            .setPositiveButton(R.string.pg_save) { _, _ ->
+                val options = PerGameSettings.Options(
+                    patch60fps = asOverride(
+                        initial.patch60fps, false, patch.isChecked
+                    ),
+                    boost = boost.isChecked,
+                    resolutionFactor = asOverride(
+                        initial.resolutionFactor,
+                        PerGameSettings.Options.DEFAULT_RESOLUTION,
+                        resolution.value.toInt()
+                    ),
+                    textureFilter = asOverride(
+                        initial.textureFilter,
+                        PerGameSettings.Options.DEFAULT_TEXTURE_FILTER,
+                        filterNames.indexOf(textureFilter.text.toString()).coerceAtLeast(0)
+                    ),
+                    linearFilter = asOverride(
+                        initial.linearFilter,
+                        PerGameSettings.Options.DEFAULT_LINEAR_FILTER,
+                        linearFilter.isChecked
+                    ),
+                    textureSampling = asOverride(
+                        initial.textureSampling,
+                        PerGameSettings.Options.DEFAULT_TEXTURE_SAMPLING,
+                        samplingNames.indexOf(sampling.text.toString()).coerceAtLeast(0)
+                    ),
+                    cpuClockPercent = asOverride(
+                        initial.cpuClockPercent,
+                        PerGameSettings.Options.DEFAULT_CPU_CLOCK,
+                        cpuClock.value.toInt()
+                    ),
+                    speedLimitPercent = asOverride(
+                        initial.speedLimitPercent,
+                        PerGameSettings.Options.DEFAULT_SPEED_LIMIT,
+                        speedLimit.value.toInt()
+                    )
+                )
+                val saved = PerGameSettings.save(game.titleId, options)
+                Toast.makeText(
+                    context,
+                    if (saved) R.string.pg_saved else R.string.pg_save_failed,
+                    Toast.LENGTH_SHORT
+                ).show()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun speedLimitText(context: Context, percent: Int): String =
+        if (percent == 0) {
+            context.getString(R.string.pg_limit_unlimited)
+        } else {
+            context.getString(R.string.pg_limit_label, "$percent%")
+        }
+}
