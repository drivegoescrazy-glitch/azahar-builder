+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+package org.citra.citra_emu.features.settings.ui
+
+import android.content.Context
+import android.view.LayoutInflater
+import android.widget.TextView
+import android.widget.Toast
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.google.android.material.materialswitch.MaterialSwitch
+import com.google.android.material.slider.Slider
+import android.view.View
+import org.citra.citra_emu.R
+import org.citra.citra_emu.features.settings.utils.PerGameSettings
+import org.citra.citra_emu.model.Game
+
+object PerGameSettingsDialog {
+    fun show(context: Context, game: Game) {
+        val view = LayoutInflater.from(context).inflate(R.layout.dialog_per_game_settings, null)
+        val values = PerGameSettings.load(game.titleId)
+
+        val enable = view.findViewById<MaterialSwitch>(R.id.pg_enable)
+        val options = view.findViewById<View>(R.id.pg_options)
+        val boost = view.findViewById<MaterialSwitch>(R.id.pg_boost)
+        val patch = view.findViewById<MaterialSwitch>(R.id.pg_60fps)
+        val limit = view.findViewById<Slider>(R.id.pg_limit)
+        val limitLabel = view.findViewById<TextView>(R.id.pg_limit_label)
+        val res = view.findViewById<Slider>(R.id.pg_res)
+        val resLabel = view.findViewById<TextView>(R.id.pg_res_label)
+        val cpu = view.findViewById<Slider>(R.id.pg_cpu)
+        val cpuLabel = view.findViewById<TextView>(R.id.pg_cpu_label)
+
+        fun refreshLabels() {
+            val l = limit.value.toInt()
+            limitLabel.text = context.getString(
+                R.string.pg_limit_label,
+                if (l == 0) context.getString(R.string.pg_limit_unlimited) else "$l%"
+            )
+            resLabel.text = context.getString(R.string.pg_res_label, res.value.toInt())
+            cpuLabel.text = context.getString(R.string.pg_cpu_label, cpu.value.toInt())
+            options.alpha = if (enable.isChecked) 1f else 0.4f
+        }
+
+        enable.isChecked = values.enabled
+        boost.isChecked = values.boost
+        patch.isChecked = values.patch60fps
+        limit.value = values.speedLimitPercent.coerceIn(0, 500).toFloat()
+        res.value = values.resolutionFactor.coerceIn(1, 10).toFloat()
+        cpu.value = values.cpuClockPercent.coerceIn(50, 400).toFloat()
+
+        enable.setOnCheckedChangeListener { _, _ -> refreshLabels() }
+        limit.addOnChangeListener { _, _, _ -> refreshLabels() }
+        res.addOnChangeListener { _, _, _ -> refreshLabels() }
+        cpu.addOnChangeListener { _, _, _ -> refreshLabels() }
+        refreshLabels()
+
+        MaterialAlertDialogBuilder(context)
+            .setTitle(context.getString(R.string.pg_title) + ": " + game.title)
+            .setView(view)
+            .setPositiveButton(R.string.pg_save) { _, _ ->
+                val saved = PerGameSettings.save(
+                    game.titleId,
+                    PerGameSettings.Values(
+                        enabled = enable.isChecked,
+                        boost = boost.isChecked,
+                        patch60fps = patch.isChecked,
+                        speedLimitPercent = limit.value.toInt(),
+                        resolutionFactor = res.value.toInt(),
+                        cpuClockPercent = cpu.value.toInt()
+                    )
+                )
+                Toast.makeText(
+                    context,
+                    if (saved) R.string.pg_saved else R.string.pg_save_failed,
+                    Toast.LENGTH_SHORT
+                ).show()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+}
