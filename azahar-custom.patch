@@ -0,0 +1,103 @@
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+package org.citra.citra_emu.features.settings.utils
+
+import androidx.documentfile.provider.DocumentFile
+import android.net.Uri
+import org.citra.citra_emu.CitraApplication
+import org.citra.citra_emu.utils.DirectoryInitialization.userDirectory
+import org.citra.citra_emu.utils.FileUtil
+import org.citra.citra_emu.utils.Log
+import org.ini4j.Wini
+
+/**
+ * Per-game overrides, stored as <user dir>/config/custom/<TITLEID>.ini. The native side layers
+ * this file over config.ini when the game boots (see Config::SourceFor in jni/config.cpp), so any
+ * key present here wins and everything else falls back to the global settings.
+ */
+object PerGameSettings {
+    data class Values(
+        var enabled: Boolean = false,
+        var boost: Boolean = false,
+        var patch60fps: Boolean = false,
+        var speedLimitPercent: Int = 100, // 0 = unlimited
+        var resolutionFactor: Int = 1,
+        var cpuClockPercent: Int = 100
+    )
+
+    private const val DIR = "custom"
+
+    fun fileName(titleId: Long) = String.format("%016X.ini", titleId)
+
+    private fun configDir(): DocumentFile? {
+        val root = DocumentFile.fromTreeUri(CitraApplication.appContext, Uri.parse(userDirectory))
+        return root?.findFile("config")
+    }
+
+    private fun customFile(titleId: Long): DocumentFile? =
+        configDir()?.findFile(DIR)?.findFile(fileName(titleId))
+
+    fun load(titleId: Long): Values {
+        val values = Values()
+        try {
+            val file = customFile(titleId) ?: return values
+            val stream = CitraApplication.appContext.contentResolver.openInputStream(file.uri)
+                ?: return values
+            stream.use {
+                val ini = Wini(it)
+                values.enabled = true
+                values.boost = ini.get("Renderer", "async_shader_compilation") == "1" &&
+                    ini.get("Renderer", "use_vsync") == "0"
+                values.patch60fps = ini.get("Renderer", "use_60fps_patch") == "1"
+                val useLimit = ini.get("Renderer", "use_frame_limit")
+                values.speedLimitPercent = if (useLimit == "0") {
+                    0
+                } else {
+                    ini.get("Renderer", "frame_limit")?.toIntOrNull() ?: 100
+                }
+                values.resolutionFactor = ini.get("Renderer", "resolution_factor")?.toIntOrNull() ?: 1
+                values.cpuClockPercent = ini.get("Core", "cpu_clock_percentage")?.toIntOrNull() ?: 100
+            }
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] load failed: ${e.message}")
+        }
+        return values
+    }
+
+    /** Writes the overrides, or deletes the file when [Values.enabled] is false. */
+    fun save(titleId: Long, values: Values): Boolean {
+        try {
+            val cfg = configDir() ?: return false
+            if (!values.enabled) {
+                cfg.findFile(DIR)?.findFile(fileName(titleId))?.delete()
+                return true
+            }
+            val dir = cfg.findFile(DIR) ?: cfg.createDirectory(DIR) ?: return false
+            val file = FileUtil.createFile(dir.uri.toString(), fileName(titleId)) ?: return false
+
+            val ini = Wini()
+            ini.put("Renderer", "use_frame_limit", if (values.speedLimitPercent == 0) 0 else 1)
+            ini.put("Renderer", "frame_limit", if (values.speedLimitPercent == 0) 100 else values.speedLimitPercent)
+            ini.put("Renderer", "resolution_factor", values.resolutionFactor)
+            ini.put("Renderer", "use_60fps_patch", if (values.patch60fps) 1 else 0)
+            ini.put("Core", "cpu_clock_percentage", values.cpuClockPercent)
+            if (values.boost) {
+                ini.put("Renderer", "use_vsync", 0)
+                ini.put("Renderer", "async_shader_compilation", 1)
+                ini.put("Renderer", "async_presentation", 1)
+                ini.put("Renderer", "use_hw_shader", 1)
+                ini.put("Renderer", "use_disk_shader_cache", 1)
+                ini.put("Renderer", "use_skip_duplicate_frames", 1)
+                ini.put("Core", "use_cpu_jit", 1)
+            }
+            val out = CitraApplication.appContext.contentResolver.openOutputStream(file.uri, "wt")
+                ?: return false
+            out.use { ini.store(it) }
+            return true
+        } catch (e: Exception) {
+            Log.error("[PerGameSettings] save failed: ${e.message}")
+            return false
+        }
+    }
+}
